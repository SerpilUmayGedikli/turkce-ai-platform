# Bu dosyayı .env adıyla kopyala ve anahtarlarını yaz.
# .env dosyası .gitignore'da: GitHub'a ASLA gitmez.

# Gateway'e erişim şifresi (kendin uydur, sk- ile başlasın)
LITELLM_MASTER_KEY=sk-degistir-beni

# Ücretsiz anahtarlar (en az birini al; README'de nereden alınacağı yazıyor)
GEMINI_API_KEY=
# Alibaba Model Studio (Singapur): Qwen + Kimi tek anahtarla
DASHSCOPE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Agent'ın varsayılan modeli (gateway/config.yaml'daki takma adlardan biri)
AGENT_MODEL=gemini

# Docker dışında çalıştırırken gateway adresi
LLM_BASE_URL=http://localhost:4000
OLLAMA_API_BASE=http://localhost:11434

POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
